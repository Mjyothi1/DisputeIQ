# Copy to .env. Never commit real keys. GEMINI_API_KEY stays on the backend only.

# --- Required (local SQLite) ---
DATABASE_URL=sqlite:///./disputeiq.db
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Fill an EMPTY database with demo data on startup. Never deletes or overwrites existing data.
BOOTSTRAP_DEMO_DATA=false
# Add the six isolated demo customers on startup (additive, idempotent, matched by name; never edits
# or deletes rows, creates no disputes). Needs the base data first. Turn off after one successful run.
BOOTSTRAP_DEMO_CUSTOMERS=false

LLM_PROVIDER=gemini

# --- Reviewer access (prototype auth, NOT SSO) ---
# "name=key" pairs, keys >= 8 chars. Generate with: python -c "import secrets;print(secrets.token_urlsafe(24))"
# Empty = every case/customer/metrics endpoint refuses (fail closed). Never commit real keys.
REVIEWER_ACCOUNTS=
# Signs customer-portal sessions. Generate like a reviewer key. If empty, a key is derived from
# REVIEWER_ACCOUNTS; with both empty the customer portal is disabled.
AUTH_SECRET=
# Demo-only password for the six demo customers' portal logins (created when
# BOOTSTRAP_DEMO_CUSTOMERS=true). Empty = no demo customer logins. Use a throwaway value.
DEMO_CUSTOMER_PASSWORD=

GEMINI_API_KEY=
# Default model lives in backend/app/core/config.py (gemini_model). Set this only to override it;
# verify the name with `python -m app.agent.cli --ping-llm` before a demo.
GEMINI_MODEL=

EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384

# --- Docker Postgres (only if you use docker compose) ---
# POSTGRES_USER=disputeiq
# POSTGRES_PASSWORD=disputeiq
# POSTGRES_DB=disputeiq
# DATABASE_URL=postgresql+psycopg://disputeiq:disputeiq@localhost:5432/disputeiq

# --- Optional ---
# LLM_MODEL=                      # overrides GEMINI_MODEL if set
# LLM_MAX_RETRIES=3
# USD_INR=88.0
# ANTHROPIC_API_KEY=              # only if LLM_PROVIDER=anthropic
# OPENAI_API_KEY=                 # only if LLM_PROVIDER=openai
# EMBEDDING_MODEL=
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LOG_JSON=false
